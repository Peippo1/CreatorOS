OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# Optional lower-cost model for repurposing after prompt evaluation.
OPENAI_REPURPOSING_MODEL=
# Keep false in production. Local development defaults to deterministic mock output.
CREATOROS_ALLOW_MOCK=true

# Optional per-stage safeguards. Invalid or blank values use safe defaults.
CREATOROS_AUDIENCE_TIMEOUT_MS=18000
CREATOROS_STRATEGY_TIMEOUT_MS=22000
CREATOROS_REPURPOSING_TIMEOUT_MS=20000
CREATOROS_AUDIENCE_MAX_OUTPUT_TOKENS=1800
CREATOROS_STRATEGY_MAX_OUTPUT_TOKENS=2400
CREATOROS_REPURPOSING_MAX_OUTPUT_TOKENS=2200

# Required for production persistence/auth. Local development may omit these values for the demo workspace.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase now labels new public browser keys as publishable keys. Either this
# or NEXT_PUBLIC_SUPABASE_ANON_KEY can be used.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public Turnstile widget key. Keep the matching secret only in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Required in production for safe magic-link redirects, e.g. https://creator-os.example.com
APP_ORIGIN=
